  "scripts": {
    "start": "NODE_OPTIONS=--max-old-space-size=8192 expo start --go --max-workers 2",
    "start:clear": "NODE_OPTIONS=--max-old-space-size=8192 expo start --go --max-workers 2 -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "export": "expo export --platform web",
    "deploy:vercel:hook": "curl -fsS -X POST https://api.vercel.com/v1/integrations/deploy/prj_onu4rpYmXcplOPOmS29auXoG4kZj/ppYbhmkdgZ -H 'Content-Type: application/json'",
    "deploy:vercel:local": "npx vercel build --prod --yes && npx vercel deploy --prebuilt --prod --yes",
    "deploy:vercel:cli": "npx vercel@latest deploy --prod --yes",
    "deploy:vercel": "npm run deploy:vercel:cli"
  },
